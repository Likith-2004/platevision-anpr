# Normalise to LF in the repository; check out native on Windows.
* text=auto

*.py   text diff=python
*.md   text
*.toml text
*.txt  text
*.html text diff=html
*.css  text diff=css
*.js   text
*.yml  text
*.env  text

# Keep Docker/shell scripts LF so they work inside Linux images.
Dockerfile   text eol=lf
*.sh         text eol=lf

# Model weights via Git LFS. Required by Hugging Face Spaces (it rejects
# non-LFS files >10 MB) and good practice anywhere for a 52 MB file.
*.pt    filter=lfs diff=lfs merge=lfs -text
*.onnx  filter=lfs diff=lfs merge=lfs -text

# Binaries
*.jpg   binary
*.jpeg  binary
*.png   binary
*.webp  binary
*.bmp   binary
