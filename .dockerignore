# Keep the build context small and the image backend-only.

# Frontend — deploys to Vercel, never part of the API image.
frontend/

# Virtualenvs and local Python caches.
inpd/
venv/
.venv/
__pycache__/
**/__pycache__/
*.pyc

# Runtime artifacts and local data.
data/
static/
*.log

# Legacy Flask app and its tests (superseded by app/main.py).
app.py
app-optimized.py
test_deployment.py

# VCS, docs, editor, CI.
.git/
.gitignore
*.md
.env
.env.*
.vscode/
.idea/

# ONNX exports and other large non-runtime model files.
model/*.onnx
